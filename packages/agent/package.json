{
  "name": "@voidhash/agent",
  "version": "0.0.1-alpha.1",
  "private": true,
  "description": "Portable durable agent sessions for Voidhash runtimes.",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/voidhashcom/voidhash",
    "directory": "packages/agent"
  },
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./AgentSessionCore": "./src/AgentSessionCore.ts",
    "./AgentToolAdapter": "./src/AgentToolAdapter.ts",
    "./EffectRunner": "./src/EffectRunner.ts",
    "./Protocol": "./src/Protocol.ts",
    "./SessionLog": "./src/SessionLog.ts",
    "./SkillSource": "./src/SkillSource.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "typecheck-go": "tsgo --noEmit",
    "test": "vp test run -c vitest.mts",
    "test:workerd": "pnpm test:workerd:bundle && pnpm test:workerd:do",
    "test:workerd:bundle": "wrangler deploy tests/workerd-probe.ts --name voidhash-agent-workerd-probe --dry-run --outdir .cache/workerd --compatibility-date 2026-03-17 --compatibility-flags nodejs_compat",
    "test:workerd:do": "node tests/run-workerd-do-probe.mjs"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "0.80.7",
    "@earendil-works/pi-ai": "0.80.7",
    "@voidhash/platform": "workspace:*",
    "effect": "catalog:",
    "typebox": "1.1.38"
  },
  "devDependencies": {
    "@voidhash/platform-node": "workspace:*",
    "@voidhash/tsconfig": "workspace:*",
    "typescript": "catalog:",
    "vite-plus": "catalog:",
    "wrangler": "^4.114.0"
  }
}
