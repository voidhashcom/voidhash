{
  "version": 1,
  "suite": "arrays",
  "cases": [
    {
      "name": "insert first item into empty array",
      "initial": {
        "kind": "array",
        "items": []
      },
      "commands": [
        {
          "kind": "array.insert",
          "path": [],
          "item": {
            "id": "i1",
            "pos": "a0",
            "value": { "kind": "string", "value": "A" }
          }
        }
      ],
      "expect": {
        "kind": "array",
        "items": [
          {
            "id": "i1",
            "pos": "a0",
            "value": { "kind": "string", "value": "A" }
          }
        ]
      }
    },
    {
      "name": "insert item between existing positions",
      "initial": {
        "kind": "array",
        "items": [
          {
            "id": "i1",
            "pos": "a0",
            "value": { "kind": "string", "value": "A" }
          },
          {
            "id": "i3",
            "pos": "a1",
            "value": { "kind": "string", "value": "C" }
          }
        ]
      },
      "commands": [
        {
          "kind": "array.insert",
          "path": [],
          "item": {
            "id": "i2",
            "pos": "a0V",
            "value": { "kind": "string", "value": "B" }
          }
        }
      ],
      "expect": {
        "kind": "array",
        "items": [
          {
            "id": "i1",
            "pos": "a0",
            "value": { "kind": "string", "value": "A" }
          },
          {
            "id": "i2",
            "pos": "a0V",
            "value": { "kind": "string", "value": "B" }
          },
          {
            "id": "i3",
            "pos": "a1",
            "value": { "kind": "string", "value": "C" }
          }
        ]
      }
    },
    {
      "name": "move item by replacing its position",
      "initial": {
        "kind": "array",
        "items": [
          {
            "id": "i1",
            "pos": "a0",
            "value": { "kind": "string", "value": "A" }
          },
          {
            "id": "i2",
            "pos": "a1",
            "value": { "kind": "string", "value": "B" }
          },
          {
            "id": "i3",
            "pos": "a2",
            "value": { "kind": "string", "value": "C" }
          }
        ]
      },
      "commands": [
        {
          "kind": "array.move",
          "path": [],
          "id": "i3",
          "pos": "a0V"
        }
      ],
      "expect": {
        "kind": "array",
        "items": [
          {
            "id": "i1",
            "pos": "a0",
            "value": { "kind": "string", "value": "A" }
          },
          {
            "id": "i3",
            "pos": "a0V",
            "value": { "kind": "string", "value": "C" }
          },
          {
            "id": "i2",
            "pos": "a1",
            "value": { "kind": "string", "value": "B" }
          }
        ]
      }
    },
    {
      "name": "delete existing item",
      "initial": {
        "kind": "array",
        "items": [
          {
            "id": "i1",
            "pos": "a0",
            "value": { "kind": "string", "value": "A" }
          },
          {
            "id": "i2",
            "pos": "a1",
            "value": { "kind": "string", "value": "B" }
          }
        ]
      },
      "commands": [
        {
          "kind": "array.delete",
          "path": [],
          "id": "i1"
        }
      ],
      "expect": {
        "kind": "array",
        "items": [
          {
            "id": "i2",
            "pos": "a1",
            "value": { "kind": "string", "value": "B" }
          }
        ]
      }
    },
    {
      "name": "edit nested field inside array item value",
      "initial": {
        "kind": "array",
        "items": [
          {
            "id": "i1",
            "pos": "a0",
            "value": {
              "kind": "object",
              "fields": {
                "done": { "kind": "boolean", "value": false }
              }
            }
          }
        ]
      },
      "commands": [
        {
          "kind": "value.set",
          "path": [
            { "kind": "item", "id": "i1" },
            { "kind": "field", "key": "done" }
          ],
          "value": { "kind": "boolean", "value": true }
        }
      ],
      "expect": {
        "kind": "array",
        "items": [
          {
            "id": "i1",
            "pos": "a0",
            "value": {
              "kind": "object",
              "fields": {
                "done": { "kind": "boolean", "value": true }
              }
            }
          }
        ]
      }
    },
    {
      "name": "reject duplicate item id on insert",
      "initial": {
        "kind": "array",
        "items": [
          {
            "id": "i1",
            "pos": "a0",
            "value": { "kind": "string", "value": "A" }
          }
        ]
      },
      "commands": [
        {
          "kind": "array.insert",
          "path": [],
          "item": {
            "id": "i1",
            "pos": "a1",
            "value": { "kind": "string", "value": "B" }
          }
        }
      ],
      "error": { "code": "duplicate_array_item_id" }
    },
    {
      "name": "reject duplicate position on insert",
      "initial": {
        "kind": "array",
        "items": [
          {
            "id": "i1",
            "pos": "a0",
            "value": { "kind": "string", "value": "A" }
          }
        ]
      },
      "commands": [
        {
          "kind": "array.insert",
          "path": [],
          "item": {
            "id": "i2",
            "pos": "a0",
            "value": { "kind": "string", "value": "B" }
          }
        }
      ],
      "error": { "code": "duplicate_array_pos" }
    },
    {
      "name": "reject move when item does not exist",
      "initial": {
        "kind": "array",
        "items": []
      },
      "commands": [
        {
          "kind": "array.move",
          "path": [],
          "id": "missing",
          "pos": "a0"
        }
      ],
      "error": { "code": "missing_array_item" }
    },
    {
      "name": "reject array command on non-array target",
      "initial": {
        "kind": "object",
        "fields": {}
      },
      "commands": [
        {
          "kind": "array.insert",
          "path": [],
          "item": {
            "id": "i1",
            "pos": "a0",
            "value": { "kind": "string", "value": "A" }
          }
        }
      ],
      "error": { "code": "type_mismatch" }
    }
  ]
}
