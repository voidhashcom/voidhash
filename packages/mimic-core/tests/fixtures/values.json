{
  "version": 1,
  "suite": "values",
  "cases": [
    {
      "name": "replace root scalar with another scalar",
      "initial": { "kind": "string", "value": "before" },
      "commands": [
        {
          "kind": "value.set",
          "path": [],
          "value": { "kind": "string", "value": "after" }
        }
      ],
      "expect": { "kind": "string", "value": "after" }
    },
    {
      "name": "replace root object with array",
      "initial": {
        "kind": "object",
        "fields": {
          "title": { "kind": "string", "value": "old" }
        }
      },
      "commands": [
        {
          "kind": "value.set",
          "path": [],
          "value": {
            "kind": "array",
            "items": [
              {
                "id": "i1",
                "pos": "a0",
                "value": { "kind": "number", "value": 1 }
              }
            ]
          }
        }
      ],
      "expect": {
        "kind": "array",
        "items": [
          {
            "id": "i1",
            "pos": "a0",
            "value": { "kind": "number", "value": 1 }
          }
        ]
      }
    },
    {
      "name": "replace existing nested scalar through field path",
      "initial": {
        "kind": "object",
        "fields": {
          "profile": {
            "kind": "object",
            "fields": {
              "name": { "kind": "string", "value": "Alice" }
            }
          }
        }
      },
      "commands": [
        {
          "kind": "value.set",
          "path": [
            { "kind": "field", "key": "profile" },
            { "kind": "field", "key": "name" }
          ],
          "value": { "kind": "string", "value": "Bob" }
        }
      ],
      "expect": {
        "kind": "object",
        "fields": {
          "profile": {
            "kind": "object",
            "fields": {
              "name": { "kind": "string", "value": "Bob" }
            }
          }
        }
      }
    },
    {
      "name": "reject value.set when target field does not exist",
      "initial": {
        "kind": "object",
        "fields": {}
      },
      "commands": [
        {
          "kind": "value.set",
          "path": [{ "kind": "field", "key": "missing" }],
          "value": { "kind": "string", "value": "x" }
        }
      ],
      "error": { "code": "missing_field" }
    }
  ]
}
