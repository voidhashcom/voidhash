{
  "version": 1,
  "suite": "batches",
  "cases": [
    {
      "name": "apply multiple object commands in one batch",
      "initial": {
        "kind": "object",
        "fields": {}
      },
      "commands": [
        {
          "kind": "object.set",
          "path": [],
          "key": "title",
          "value": { "kind": "string", "value": "Hello" }
        },
        {
          "kind": "object.set",
          "path": [],
          "key": "count",
          "value": { "kind": "number", "value": 1 }
        }
      ],
      "expect": {
        "kind": "object",
        "fields": {
          "title": { "kind": "string", "value": "Hello" },
          "count": { "kind": "number", "value": 1 }
        }
      }
    },
    {
      "name": "batch may reference state created earlier in the same batch",
      "initial": {
        "kind": "tree",
        "nodes": []
      },
      "commands": [
        {
          "kind": "tree.insert",
          "path": [],
          "node": {
            "id": "n1",
            "parent": "$root",
            "pos": "a0",
            "value": {
              "kind": "object",
              "fields": {
                "title": { "kind": "string", "value": "Parent" }
              }
            }
          }
        },
        {
          "kind": "tree.insert",
          "path": [],
          "node": {
            "id": "n2",
            "parent": "n1",
            "pos": "a0",
            "value": {
              "kind": "object",
              "fields": {
                "title": { "kind": "string", "value": "Child" }
              }
            }
          }
        }
      ],
      "expect": {
        "kind": "tree",
        "nodes": [
          {
            "id": "n1",
            "parent": "$root",
            "pos": "a0",
            "value": {
              "kind": "object",
              "fields": {
                "title": { "kind": "string", "value": "Parent" }
              }
            }
          },
          {
            "id": "n2",
            "parent": "n1",
            "pos": "a0",
            "value": {
              "kind": "object",
              "fields": {
                "title": { "kind": "string", "value": "Child" }
              }
            }
          }
        ]
      }
    },
    {
      "name": "batch is atomic when a later command fails",
      "initial": {
        "kind": "array",
        "items": [
          {
            "id": "i1",
            "pos": "a0",
            "value": { "kind": "string", "value": "A" }
          }
        ]
      },
      "commands": [
        {
          "kind": "array.insert",
          "path": [],
          "item": {
            "id": "i2",
            "pos": "a1",
            "value": { "kind": "string", "value": "B" }
          }
        },
        {
          "kind": "array.insert",
          "path": [],
          "item": {
            "id": "i3",
            "pos": "a1",
            "value": { "kind": "string", "value": "C" }
          }
        }
      ],
      "error": { "code": "duplicate_array_pos" }
    },
    {
      "name": "batch can create array item then mutate inside it",
      "initial": {
        "kind": "array",
        "items": []
      },
      "commands": [
        {
          "kind": "array.insert",
          "path": [],
          "item": {
            "id": "i1",
            "pos": "a0",
            "value": {
              "kind": "object",
              "fields": {}
            }
          }
        },
        {
          "kind": "object.set",
          "path": [{ "kind": "item", "id": "i1" }],
          "key": "title",
          "value": { "kind": "string", "value": "Created in batch" }
        }
      ],
      "expect": {
        "kind": "array",
        "items": [
          {
            "id": "i1",
            "pos": "a0",
            "value": {
              "kind": "object",
              "fields": {
                "title": { "kind": "string", "value": "Created in batch" }
              }
            }
          }
        ]
      }
    }
  ]
}
