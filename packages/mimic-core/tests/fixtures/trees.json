{
  "version": 1,
  "suite": "trees",
  "cases": [
    {
      "name": "insert first root-level node into empty tree",
      "initial": {
        "kind": "tree",
        "nodes": []
      },
      "commands": [
        {
          "kind": "tree.insert",
          "path": [],
          "node": {
            "id": "n1",
            "parent": "$root",
            "pos": "a0",
            "value": {
              "kind": "object",
              "fields": {
                "title": { "kind": "string", "value": "Node 1" }
              }
            }
          }
        }
      ],
      "expect": {
        "kind": "tree",
        "nodes": [
          {
            "id": "n1",
            "parent": "$root",
            "pos": "a0",
            "value": {
              "kind": "object",
              "fields": {
                "title": { "kind": "string", "value": "Node 1" }
              }
            }
          }
        ]
      }
    },
