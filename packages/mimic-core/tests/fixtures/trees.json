        {
          "kind": "tree.move",
          "path": [],
          "id": "n1",
          "parent": "n2",
          "pos": "a0"
        }
      ],
      "error": { "code": "tree_cycle" }
    },
    {
      "name": "reject duplicate node id on insert",
      "initial": {
        "kind": "tree",
        "nodes": [
          {
            "id": "n1",
            "parent": "$root",
