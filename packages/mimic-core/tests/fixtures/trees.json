    {
      "name": "edit nested field inside node value object",
      "initial": {
        "kind": "tree",
        "nodes": [
          {
            "id": "n1",
            "parent": "$root",
            "pos": "a0",
            "value": {
              "kind": "object",
              "fields": {
                "done": { "kind": "boolean", "value": false }
              }
            }
          }
        ]
      },
      "commands": [
        {
          "kind": "value.set",
          "path": [
            { "kind": "node", "id": "n1" },
            { "kind": "field", "key": "done" }
          ],
          "value": { "kind": "boolean", "value": true }
        }
      ],
      "expect": {
        "kind": "tree",
        "nodes": [
          {
            "id": "n1",
            "parent": "$root",
            "pos": "a0",
            "value": {
              "kind": "object",
              "fields": {
                "done": { "kind": "boolean", "value": true }
              }
            }
          }
        ]
      }
    },
    {
      "name": "reject tree insert with missing parent",
      "initial": {
        "kind": "tree",
        "nodes": []
      },
      "commands": [
        {
          "kind": "tree.insert",
          "path": [],
          "node": {
            "id": "n1",
