{
  "extends": "@voidhash/tsconfig/internal-package-typescript-6.json",
  "include": ["src", "test", "sst-env.d.ts"],
  "exclude": [
    "**/node_modules/**",
    // This reaches into the React Native SDK internals, which rootDir rejects.
    "test/_testing/ReactNativePurchaseHarness.ts"
  ],
  "compilerOptions": {
    "rootDir": ".",
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    // Deploy loads these files via Node's strip-only TS support, which rejects
    // non-erasable syntax (parameter properties, enums, runtime namespaces).
    // Fail typecheck on it here so CI catches it before the deploy step.
    "erasableSyntaxOnly": true,
    "paths": {
      "@testing/*": ["./test/_testing/*"]
    }
  }
}
