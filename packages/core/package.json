{
  "name": "@voidhash/core",
  "version": "0.0.1-alpha.1",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/voidhashcom/voidhash",
    "directory": "packages/db"
  },
  "main": "./index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./services": "./src/services/index.ts",
    "./repositories": "./src/repositories/index.ts",
    "./utils": "./src/utils/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run -c vitest.unit.mts",
    "test:integration": "vitest run -c vitest.integration.mts --bail=1"
  },
  "dependencies": {
    "@voidhash/auth": "workspace:*",
    "@voidhash/api-spec": "workspace:*",
    "@voidhash/db": "workspace:*",
    "@voidhash/lib": "workspace:*",
    "@voidhash/shared": "workspace:*"
  },
  "devDependencies": {
    "@voidhash/tsconfig": "workspace:*",
    "typescript": "5.8.3"
  },
  "peerDependencies": {
    "@effect/workflow": "catalog:",
    "effect": "catalog:"
  }
}