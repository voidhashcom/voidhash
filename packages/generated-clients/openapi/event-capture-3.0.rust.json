{
  "openapi": "3.0.3",
  "info": {
    "title": "Api",
    "version": "0.0.1"
  },
  "paths": {
    "/i/v1/capture": {
      "post": {
        "tags": ["event_capture"],
        "operationId": "event_capture.capture",
        "parameters": [
          {
            "name": "x-secret-key",
            "in": "header",
            "schema": {
              "type": "string"
            },
            "required": false
          }
        ],
        "security": [],
        "responses": {
          "202": {
            "description": "CaptureAcceptedResponse",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CaptureAcceptedResponse"
                }
              }
            }
          },
          "400": {
            "description": "CaptureInvalidRequestError",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "401": {
            "description": "CaptureUnauthorizedError",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "413": {
            "description": "CapturePayloadTooLargeError",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "429": {
            "description": "CaptureRateLimitedError",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "500": {
            "description": "CaptureInternalServerError",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "503": {
            "description": "CaptureDependencyUnavailableError",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        },
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "uuid": {
                    "type": "string",
                    "minLength": 1
                  },
                  "event": {
                    "type": "string",
                    "minLength": 1
                  },
                  "context": {
                    "type": "object",
                    "additionalProperties": {
                      "$ref": "#/components/schemas/CaptureEventValue"
                    }
                  },
                  "properties": {
                    "type": "object",
                    "additionalProperties": {
                      "$ref": "#/components/schemas/CaptureContextValue"
                    }
                  },
                  "distinct_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "session_id": {
                    "nullable": true,
                    "type": "string",
                    "minLength": 1
                  },
                  "timestamp": {
                    "type": "string"
                  },
                  "sent_at": {
                    "type": "string"
                  },
                  "token": {
                    "nullable": true,
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "uuid",
                  "event",
                  "context",
                  "properties",
                  "distinct_id",
                  "timestamp",
                  "sent_at"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": true
        }
      }
    },
    "/i/v1/batch": {
      "post": {
        "tags": ["event_capture"],
        "operationId": "event_capture.batch",
        "parameters": [
          {
            "name": "x-secret-key",
            "in": "header",
            "schema": {
              "type": "string"
            },
            "required": false
          }
        ],
        "security": [],
        "responses": {
          "202": {
            "description": "CaptureAcceptedResponse",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CaptureAcceptedResponse"
                }
              }
            }
          },
          "400": {
            "description": "CaptureInvalidRequestError",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "401": {
            "description": "CaptureUnauthorizedError",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "413": {
            "description": "CapturePayloadTooLargeError",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "429": {
            "description": "CaptureRateLimitedError",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "500": {
            "description": "CaptureInternalServerError",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "503": {
            "description": "CaptureDependencyUnavailableError",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        },
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "events": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "object",
                      "properties": {
                        "uuid": {
                          "type": "string",
                          "minLength": 1
                        },
                        "event": {
                          "type": "string",
                          "minLength": 1
                        },
                        "context": {
                          "type": "object",
                          "additionalProperties": {
                            "$ref": "#/components/schemas/CaptureEventValue"
                          }
                        },
                        "properties": {
                          "type": "object",
                          "additionalProperties": {
                            "$ref": "#/components/schemas/CaptureContextValue"
                          }
                        },
                        "distinct_id": {
                          "type": "string",
                          "minLength": 1
                        },
                        "session_id": {
                          "nullable": true,
                          "type": "string",
                          "minLength": 1
                        },
                        "timestamp": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "uuid",
                        "event",
                        "context",
                        "properties",
                        "distinct_id",
                        "timestamp"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "sent_at": {
                    "type": "string"
                  },
                  "token": {
                    "nullable": true,
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": ["events", "sent_at"],
                "additionalProperties": false
              }
            }
          },
          "required": true
        }
      }
    }
