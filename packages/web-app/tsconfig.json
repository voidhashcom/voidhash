{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": false,
    "strictNullChecks": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "types": ["node", "vite/client"],
    "paths": {
      "@/*": ["./src/*"],
      "virtual:voidhash-web/auth-browser": ["./src/composition/community/auth-browser.ts"],
      "virtual:voidhash-web/auth-server": ["./src/composition/community/auth-server.ts"],
      "virtual:voidhash-web/edition": ["./src/composition/community/edition.ts"]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.d.ts",
    "../../apps/www/src/routeTree.gen.ts"
  ],
  "exclude": ["node_modules", "src/features/studio/.cache/**", "src/features/studio/.turbo/**"]
}
