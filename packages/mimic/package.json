{
  "name": "@voidhash/mimic",
  "version": "1.0.0-beta.19",
  "private": true,
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/voidhashcom/voidhash",
    "directory": "packages/mimic"
  },
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "require": "./dist/index.cjs"
    },
    "./client": {
      "types": "./src/client/index.ts",
      "import": "./src/client/index.ts",
      "require": "./dist/client/index.cjs"
    },
    "./zustand": {
      "types": "./src/zustand/index.ts",
      "import": "./src/zustand/index.ts",
      "require": "./dist/zustand/index.cjs"
    },
    "./zustand-commander": {
      "types": "./src/zustand-commander/index.ts",
      "import": "./src/zustand-commander/index.ts",
      "require": "./dist/zustand-commander/index.cjs"
    }
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vp test run -c vitest.mts",
    "test:watch": "vp test -c vitest.mts"
  },
  "dependencies": {
    "@voidhash/mimic-core": "workspace:*"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@voidhash/mimic-core": "workspace:*",
    "jsdom": "^26.1.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tsdown": "^0.18.2",
    "typescript": "5.8.3",
    "vite-plus": "0.1.23",
    "vitest": "^3.2.7",
    "zustand": "^5.0.9"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "zustand": "^5.0.9"
  }
}
