{
  "name": "@voidhash/auth-app",
  "version": "0.0.1-alpha.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun with-env vite dev",
    "build": "vite build",
    "start": "node .output/server/index.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format . --write",
    "trigger:dev": "bun with-env npx trigger.dev@latest dev",
    "trigger:deploy": "bun with-env npx trigger.dev@latest deploy",
    "trigger:deploy-staging": "bun with-env npx trigger.dev@latest deploy --env staging",
    "with-env": "dotenv -e .env --"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.2.8",
    "@fontsource-variable/geist-mono": "^5.2.7",
    "@tanstack/react-router": "^1.140.0",
    "@tanstack/react-start": "^1.140.0",
    "@tanstack/zod-adapter": "^1.140.0",
    "@voidhash/auth": "workspace:*",
    "@voidhash/lib": "workspace:*",
    "@voidhash/ui": "workspace:*",
    "@better-auth/oauth-provider": "^1.4.10",
    "better-auth": "^1.4.10",
    "cross-fetch": "^4.1.0",
    "drizzle-orm": "^0.45.1",
    "lucide-react": "^0.555.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-hook-form": "^7.60.0",
    "slug": "^11.0.0",
    "resend": "^4.5.1",
    "sonner": "^2.0.1",
    "vite-tsconfig-paths": "^5.1.4",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.17",
    "@types/node": "^24.0.12",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.1.1",
    "@voidhash/tsconfig": "workspace:*",
    "babel-plugin-react-compiler": "19.1.0-rc.2",
    "dotenv-cli": "^7.4.4",
    "tailwindcss": "^4.1.17",
    "tw-animate-css": "^1.2.4",
    "typescript": "5.6.3",
    "vite": "^7.2.6",
    "vitest": "^3.2.4"
  }
}
