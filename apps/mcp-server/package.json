{
  "name": "voidhash-mcp-server",
  "version": "0.0.1-alpha.1",
  "private": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/voidhashcom/voidhash",
    "directory": "apps/mcp-server"
  },
  "bin": {
    "voidhash-mcp-server": "./dist/index.cjs"
  },
  "type": "module",
  "scripts": {
    "start": "tsx ./src/index.ts",
    "build": "tsup src/index.ts --format cjs --out-dir dist --clean && (echo '#!/usr/bin/env node' && cat ./dist/index.cjs) > ./dist/index.cjs.tmp && mv ./dist/index.cjs.tmp ./dist/index.cjs && chmod +x ./dist/index.cjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run -c vitest.mts"
  },
  "dependencies": {
    "@effect/platform": "catalog:",
    "@modelcontextprotocol/sdk": "^1.25.2",
    "@voidhash/api-spec": "workspace:*",
    "@voidhash/mimic": "catalog:",
    "@voidhash/paywall-designer-schema": "workspace:*",
    "effect": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@voidhash/tsconfig": "workspace:*",
    "tsup": "^6.1.3",
    "tsx": "^4.19.3",
    "typescript": "5.6.3",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.2.4"
  }
}
