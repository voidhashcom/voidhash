{
  "name": "@voidhash/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "start": "bun run src/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format . --write",
    "test": "vitest run -c vitest.unit.mts",
    "test:integration": "vitest run -c vitest.integration.mts --bail=1"
  },
  "dependencies": {
    "@effect/platform": "catalog:",
    "@effect/platform-bun": "^0.81.1",
    "@effect/platform-node": "catalog:",
    "@voidhash/api-spec": "workspace:*",
    "@voidhash/auth": "workspace:*",
    "@voidhash/core": "workspace:*",
    "@voidhash/db": "workspace:*",
    "@voidhash/lib": "workspace:*",
    "@voidhash/rpc": "workspace:*",
    "@voidhash/shared": "workspace:*",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@voidhash/tsconfig": "workspace:*",
    "typescript": "^5"
  }
}