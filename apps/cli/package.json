{
  "name": "voidhash-cli",
  "version": "0.0.1-alpha.1",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/voidhashcom/voidhash",
    "directory": "packages/db"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "bin": {
    "voidhash-cli": "./dist/bin.cjs"
  },
  "scripts": {
    "start": "dotenv -- tsx ./src/index.ts",
    "build": "rm -rf ./dist && tsx build.ts && cp package.json dist/ && chmod +x ./dist/bin.cjs",
    "build:dev": "rm -rf ./dist && tsx build.dev.ts && chmod +x ./dist/index.cjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@effect/cli": "catalog:",
    "@effect/platform": "catalog:",
    "@effect/platform-node": "catalog:",
    "@voidhash/api-spec": "workspace:*",
    "better-auth": "^1.3.11",
    "effect": "catalog:",
    "esbuild-register": "^3.6.0",
    "nanoid": "^5.1.5"
  },
  "devDependencies": {
    "@effect/language-service": "catalog:",
    "@voidhash/tsconfig": "workspace:*",
    "dotenv-cli": "^10.0.0",
    "esbuild": "^0.25.10",
    "tsup": "^6.1.3",
    "tsx": "^4.19.3",
    "typescript": "5.6.3",
    "vitest": "^3.0.9"
  }
}