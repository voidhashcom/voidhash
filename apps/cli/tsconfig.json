{
  "extends": "@voidhash/tsconfig/internal-package.json",
  "include": ["src"],
  "exclude": ["**/node_modules/**"],
  "compilerOptions": {
    "rootDir": "./src",
    "lib": ["ES2022", "DOM"],
    "allowImportingTsExtensions": true,
    "plugins": [
      {
        "name": "@effect/language-service"
      }
    ]
  }
}
