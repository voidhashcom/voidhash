{
  "name": "@voidhash/root",
  "version": "0.0.1-alpha.1",
  "private": true,
  "license": "MIT",
  "workspaces": {
    "packages": [
      "packages/*",
      "apps/*",
      "libraries/*",
      "examples/*"
    ],
    "catalogs": {
      "react18": {
        "react": "18.3.1",
        "react-dom": "18.3.1"
      }
    },
    "catalog": {
      "@types/react": "^19.1.0",
      "@types/react-dom": "^19.1.0",
