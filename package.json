{
  "name": "@voidhash/root",
  "private": true,
  "type": "module",
  "version": "0.0.1-alpha.1",
  "packageManager": "pnpm@10.19.0",
  "license": "AGPL-3.0",
  "resolutions": {
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "scripts": {
    "build": "turbo build",
    "dev": "turbo  dev",
    "clean": "turbo clean && rm -rf node_modules",
    "format": "biome format . --write",
    "lint": "biome check .",
    "lint:fix": "biome check . --apply",
    "bump": "bumpp",
    "test": "turbo test",
    "typecheck": "turbo typecheck",
    "api:start": "turbo run start --filter=@voidhash/api --env-mode=loose",
    "api:build": "turbo run build --filter=@voidhash/api --env-mode=loose",
    "better-auth:generate": "bun run with-env npx @better-auth/cli@latest generate --config ./packages/auth/src/index.ts --output ./packages/db/auth-schema.ts",
    "better-auth:migrate": "bun run with-env npx @better-auth/cli@latest migrate --config ./packages/auth/src/index.ts",
    "db:generate": "bun run with-env drizzle-kit generate",
    "db:migrate": "bun run with-env drizzle-kit migrate",
    "db:studio": "bun run with-env drizzle-kit studio",
    "db:push": "bun run with-env drizzle-kit push",
    "with-env": "dotenv -e ./apps/api/.env --",
    "lines-of-code": "npx cloc . --exclude-dir=.next,node_modules,.vercel,.turbo,.git,meta,.github,.expo,build,.expo-shared,nitrogen --vcs git --not-match-f=bun.lockb,meta.json --exclude-ext=yaml,md"
  },
  "dependencies": {
    "@effect/language-service": "catalog:",
    "@types/node": "^24.0.12",
    "bumpp": "^10.2.0",
    "cross-env": "^7.0.3",
    "drizzle-kit": "^0.31.4",
    "simple-git-hooks": "^2.11.1",
    "taze": "^0.18.0",
    "tinyglobby": "^0.2.10",
    "turbo": "^2.3.3",
    "typescript": "5.6.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.1.2",
    "dotenv-cli": "^8.0.0",
    "ultracite": "5.0.39"
  },
  "workspaces": {
    "packages": [
      "packages/*",
      "apps/*",
      "libraries/*",
      "examples/*"
    ],
    "catalogs": {
      "react18": {
        "react": "18.3.1",
        "react-dom": "18.3.1"
      }
    },
    "catalog": {
      "@types/react": "^18.3.14",
      "@types/react-dom": "^18.3.2",
      "@trpc/client": "^11.1.0",
      "@trpc/server": "^11.1.0",
      "@tanstack/react-query": "^5.90.5",
      "@trpc/tanstack-react-query": "^11.1.0",
      "effect": "^3.18.4",
      "@effect/platform-node": "^0.98.4",
      "@effect/platform": "^0.92.1",
      "@effect/cli": "^0.71.0",
      "@effect/language-service": "^0.48.0",
      "@effect/vitest": "^0.26.0",
      "superjson": "^2.2.2"
    }
  }
}