{
  "extends": "../../packages/tsconfig/react-library.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "rootDir": ".",
    "types": ["node"]
  },
  "include": ["src", "tests", "build.ts", "vitest.unit.mts"],
