{
  "$schema": "https://nitro.margelo.com/nitro.schema.json",
  "cxxNamespace": ["voidhash"],
  "ios": {
    "iosModuleName": "NitroVoidhash"
  },
  "android": {
    "androidNamespace": ["voidhash"],
    "androidCxxLibName": "NitroVoidhash"
  },
  "autolinking": {
    "Voidhash": {
      "swift": "HybridVoidhash",
      "kotlin": "HybridVoidhash"
    },
    "Storekit": {
      "swift": "HybridStorekit"
    },
    "GoogleBilling": {
      "kotlin": "HybridGoogleBilling"
    },
    "PaywallWebView": {
      "swift": "HybridPaywallWebView",
      "kotlin": "HybridPaywallWebView"
    }
  },
  "ignorePaths": ["**/node_modules"]
}
