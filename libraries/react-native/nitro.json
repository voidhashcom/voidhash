{
  "$schema": "https://nitro.margelo.com/nitro.schema.json",
  "cxxNamespace": ["voidhash"],
  "ios": {
    "iosModuleName": "NitroVoidhash"
  },
  "android": {
    "androidNamespace": ["voidhash"],
    "androidCxxLibName": "NitroVoidhash"
  },
  "autolinking": {
    "Voidhash": {
      "ios": { "language": "swift", "implementationClassName": "HybridVoidhash" },
      "android": { "language": "kotlin", "implementationClassName": "HybridVoidhash" }
    },
    "Storekit": {
      "ios": { "language": "swift", "implementationClassName": "HybridStorekit" }
    },
    "GoogleBilling": {
      "android": { "language": "kotlin", "implementationClassName": "HybridGoogleBilling" }
    },
    "PaywallWebView": {
      "ios": { "language": "swift", "implementationClassName": "HybridPaywallWebView" },
      "android": { "language": "kotlin", "implementationClassName": "HybridPaywallWebView" }
    },
    "PaywallPresenter": {
      "ios": { "language": "swift", "implementationClassName": "HybridPaywallPresenter" },
      "android": { "language": "kotlin", "implementationClassName": "HybridPaywallPresenter" }
    }
  },
  "ignorePaths": ["**/node_modules"]
}
