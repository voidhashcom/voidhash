{
  "$schema": "https://nitro.margelo.com/nitro.schema.json",
  "cxxNamespace": ["voidhash"],
  "ios": {
    "iosModuleName": "NitroVoidhash"
  },
  "android": {
    "androidNamespace": ["voidhash"],
    "androidCxxLibName": "NitroVoidhash"
  },
  "autolinking": {
    "VoidhashNativeClient": {
      "ios": {
        "language": "swift",
        "implementationClassName": "HybridVoidhashNativeClient"
      },
      "android": {
        "language": "kotlin",
        "implementationClassName": "HybridVoidhashNativeClient"
      }
    }
  },
  "ignorePaths": ["**/node_modules"]
}
