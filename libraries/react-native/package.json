{
	"name": "@voidhash/react-native",
	"version": "0.0.1",
	"description": "React Native SDK for in-app purchases.",
	"keywords": [
		"nitro",
		"react-native"
	],
	"homepage": "https://voidhash.com/docs",
	"bugs": {
		"url": "https://github.com/mrousavy/nitro/issues"
	},
	"license": "MIT",
	"author": "Marc Rousavy <me@mrousavy.com> (https://github.com/mrousavy)",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/mrousavy/nitro.git"
	},
	"source": "src/index",
	"files": [
		"*.podspec",
		"app.plugin.js",
		"build",
		"nitrogen",
		"react-native.config.js",
		"README.md",
		"src",
		"android/build.gradle",
		"android/CMakeLists.txt",
		"android/gradle.properties",
		"android/src",
		"ios/**/*.cpp",
		"ios/**/*.h",
		"ios/**/*.m",
		"ios/**/*.mm",
		"ios/**/*.swift"
	],
	"main": "build/index",
	"module": "build/index",
	"types": "build/index.d.ts",
	"react-native": "src/index",
	"publishConfig": {
		"registry": "https://registry.npmjs.org/"
	},
	"exports": {
		"./schema": "./src/core/schema/index.ts",
		".": "./src/index.ts"
	},
	"scripts": {
		"postinstall": "tsc || exit 0;",
		"typecheck": "tsgo --noEmit",
		"build": "expo-module build",
		"test": "expo-module test",
		"clean": "rm -rf android/build node_modules/**/android/build lib",
		"lint": "biome check .",
		"lint-ci": "biome check .",
		"format": "biome format . --write",
		"typescript": "tsc",
		"specs": "bun run typescript && nitro-codegen --logLevel=\"debug\""
	},
	"dependencies": {
		"neverthrow": "^8.2.0"
	},
	"devDependencies": {
		"@expo/config-plugins": "^10.0.2",
		"@types/jest": "^30.0.0",
		"@types/react": "~19.0.14",
		"@vitejs/plugin-react": "^4.6.0",
		"@voidhash/api-spec": "workspace:*",
		"@voidhash/shared": "workspace:*",
		"expo-module-scripts": "^4.0.5",
		"jest": "~29.7.0",
		"jest-expo": "~53.0.9",
		"jest-fixed-jsdom": "^0.0.9",
		"nitro-codegen": "*",
		"react": "19.0.0",
		"react-native": "0.79.5",
		"react-native-nitro-modules": "0.26.4",
		"typescript": "5.6.3",
		"ultracite": "5.0.39"
	},
	"peerDependencies": {
		"@effect/platform": "catalog:",
		"@react-native-async-storage/async-storage": "^1.24.0 || ^2.0.0",
		"effect": "catalog:",
		"expo": "*",
		"expo-constants": "*",
		"expo-linking": "*",
		"react": "*",
		"react-native": "*",
		"react-native-nitro-modules": "0.26.4"
	},
	"jest": {
		"moduleNameMapper": {
			"^msgpackr$": "<rootDir>/../../node_modules/msgpackr/dist/node.cjs"
		},
		"modulePathIgnorePatterns": [
			"<rootDir>/lib/",
			"<rootDir>/build/"
		],
		"preset": "expo-module-scripts",
		"projects": [],
		"setupFiles": [
			"<rootDir>/jest.setup.ts"
		],
		"testPathIgnorePatterns": [
			"<rootDir>/src/__tests__/helpers/"
		],
		"testEnvironment": "jest-fixed-jsdom"
	},
	"packageManager": "bun@1.3.1"
}
