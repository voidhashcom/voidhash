{
	"name": "@voidhash/react-native",
	"version": "0.0.1-alpha.1",
	"private": false,
	"description": "Voidhash React Native SDK for in-app purchases.",
	"keywords": [
		"voidhash",
		"sdk",
		"nitro",
		"react-native",
		"expo",
		"payments"
	],
	"homepage": "https://voidhash.com/docs",
	"bugs": {
		"url": "https://github.com/voidhashcom/voidhash/issues"
	},
	"license": "MIT",
	"author": "Voidhash (https://voidhash.com)",
	"repository": {
		"type": "git",
		"url": "https://github.com/voidhashcom/voidhash",
		"directory": "libraries/react-native"
	},
	"source": "src/index",
	"files": [
		"*.podspec",
		"app.plugin.js",
		"build",
		"nitrogen",
		"react-native.config.js",
		"README.md",
		"src",
		"android/build.gradle",
		"android/CMakeLists.txt",
		"android/gradle.properties",
		"android/src",
		"ios/**/*.cpp",
		"ios/**/*.h",
		"ios/**/*.m",
		"ios/**/*.mm",
		"ios/**/*.swift"
	],
	"main": "build/index",
	"module": "build/index",
	"types": "build/index.d.ts",
	"react-native": "src/index",
	"publishConfig": {
		"access": "public",
		"registry": "https://registry.npmjs.org/"
	},
	"exports": {
		"./app.plugin.js": "./app.plugin.js",
		"./package.json": "./package.json",
		"./schema": "./src/core/schema/index.ts",
		".": "./src/index.ts"
	},
	"scripts": {
		"postinstall": "tsc || exit 0;",
		"typecheck": "tsgo --noEmit",
		"build": "expo-module build",
		"test": "expo-module test",
		"clean": "rm -rf android/build node_modules/**/android/build lib",
		"lint": "biome check .",
		"lint-ci": "biome check .",
		"format": "biome format . --write",
		"typescript": "tsc",
		"specs": "pnpm run typescript && nitro-codegen --logLevel=\"debug\""
	},
	"dependencies": {
		"@voidhash/generated-clients": "workspace:*"
	},
	"devDependencies": {
		"@types/jest": "^29.5.14",
		"@types/react": "~19.1.10",
		"@vitejs/plugin-react": "^4.6.0",
		"@voidhash/shared": "workspace:*",
		"expo": "54.0.33",
		"expo-constants": "~18.0.13",
		"expo-linking": "~8.0.9",
		"expo-module-scripts": "^5.0.8",
		"jest": "~29.7.0",
		"jest-expo": "~54.0.17",
		"jest-fixed-jsdom": "^0.0.9",
		"nitro-codegen": "0.26.4",
		"react": "19.1.0",
		"react-native": "0.81.5",
		"react-native-nitro-modules": "0.26.4",
		"typescript": "5.9.3",
		"ultracite": "5.0.39"
	},
	"peerDependencies": {
		"@react-native-async-storage/async-storage": "^1.24.0 || ^2.0.0",
		"effect": "catalog:",
		"expo": "*",
		"expo-constants": "*",
		"expo-linking": "*",
		"react": "*",
		"react-native": "*",
		"react-native-nitro-modules": "0.26.4"
	},
	"jest": {
		"moduleNameMapper": {
			"^msgpackr$": "<rootDir>/../../node_modules/msgpackr/dist/node.cjs"
		},
		"modulePathIgnorePatterns": [
			"<rootDir>/lib/",
			"<rootDir>/build/"
		],
		"preset": "expo-module-scripts",
		"projects": [],
		"setupFiles": [
			"<rootDir>/jest.setup.ts"
		],
		"testPathIgnorePatterns": [
			"<rootDir>/src/__tests__/helpers/"
		],
		"testEnvironment": "jest-fixed-jsdom"
	},
	"packageManager": "pnpm@10.19.0"
}
