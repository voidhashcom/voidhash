{
  "name": "@voidhash/react-native",
  "packageManager": "bun@1.3.1",
  "version": "0.0.1",
  "description": "React Native SDK for in-app purchases.",
  "main": "build/index",
  "module": "build/index",
  "types": "build/index.d.ts",
  "react-native": "src/index",
  "source": "src/index",
  "files": [
    "src",
    "react-native.config.js",
    "build",
    "nitrogen",
    "android/build.gradle",
    "android/gradle.properties",
    "android/CMakeLists.txt",
    "android/src",
    "ios/**/*.h",
    "ios/**/*.m",
    "ios/**/*.mm",
    "ios/**/*.cpp",
    "ios/**/*.swift",
    "app.plugin.js",
    "*.podspec",
    "README.md"
  ],
  "homepage": "https://voidhash.com/docs",
  "scripts": {
    "postinstall": "tsc || exit 0;",
    "typecheck": "tsc --noEmit",
    "build": "expo-module build",
    "test": "expo-module test",
    "clean": "rm -rf android/build node_modules/**/android/build lib",
    "lint": "biome check .",
    "lint-ci": "biome check .",
    "format": "biome format . --write",
    "typescript": "tsc",
    "specs": "bun run typescript && nitro-codegen --logLevel=\"debug\""
  },
  "keywords": [
    "react-native",
    "nitro"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mrousavy/nitro.git"
  },
  "author": "Marc Rousavy <me@mrousavy.com> (https://github.com/mrousavy)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/mrousavy/nitro/issues"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "@expo/config-plugins": "^10.0.2",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.0.14",
    "@vitejs/plugin-react": "^4.6.0",
    "@voidhash/api-spec": "workspace:*",
    "@voidhash/shared": "workspace:*",
    "expo-module-scripts": "^4.0.5",
    "jest": "~29.7.0",
    "jest-expo": "~53.0.9",
    "jest-fixed-jsdom": "^0.0.9",
    "nitro-codegen": "*",
    "react": "19.0.0",
    "react-native": "0.79.5",
    "react-native-nitro-modules": "0.26.4",
    "typescript": "5.6.3",
    "ultracite": "5.0.39"
  },
  "peerDependencies": {
    "@effect/platform": "catalog:",
    "effect": "catalog:",
    "expo": "*",
    "expo-constants": "*",
    "expo-linking": "*",
    "react": "*",
    "react-native": "*",
    "react-native-nitro-modules": "0.26.4",
    "@react-native-async-storage/async-storage": "^1.24.0 || ^2.0.0"
  },
  "dependencies": {
    "neverthrow": "^8.2.0"
  },
  "jest": {
    "preset": "expo-module-scripts",
    "testEnvironment": "jest-fixed-jsdom",
    "projects": [],
    "modulePathIgnorePatterns": [
      "<rootDir>/lib/"
    ]
  }
}