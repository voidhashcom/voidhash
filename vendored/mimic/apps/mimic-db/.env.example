# Local standalone dev server (in-memory backend).
PORT=5001

# Bootstrap superuser (also used by the Durable Object control plane).
ROOT_USERNAME=root
ROOT_PASSWORD=password

# Public base URL used when building document-token connection URLs.
MIMIC_PUBLIC_BASE_URL=https://mimic.voidhash.localhost

# Comma-separated CORS origins for the RPC + WebSocket endpoints.
# CORS_ORIGINS=https://mimic-admin.voidhash.localhost,https://mimic-example.voidhash.localhost,http://localhost:3003,http://localhost:5173

# Document behavior.
# MIMIC_DOCUMENT_SNAPSHOT_EVERY_COMMANDS=100
# MIMIC_DOCUMENT_HEARTBEAT_MS=30000
# MIMIC_DOCUMENT_PRESENCE_TTL_MS=75000
