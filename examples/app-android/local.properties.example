# Copy to `local.properties` (which is never committed) and fill in your key.
# Studio → Project settings → API keys → publishable key.
voidhash.publishableKey=vh_pk_replace_me

# Optional: the API origin. Debug builds may use cleartext HTTP to the machine
# hosting the emulator, for a backend running locally.
# voidhash.apiBaseUrl=http://10.0.2.2:8788

# Android Studio writes this line for you. Set ANDROID_HOME instead when
# building from the command line.
# sdk.dir=/Users/you/Library/Android/sdk
