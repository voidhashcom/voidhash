# Secret key from Studio → Project settings → API keys. Required.
# Grants full project access — keep it on the server, never in an app bundle.
# A staging server uses a test secret key (vh_sk_test_...) instead.
VOIDHASH_SECRET_KEY=vh_sk_...

# Signing secret of the webhook endpoint you created in Studio.
# Required by POST /webhooks/voidhash; the route answers 503 without it.
VOIDHASH_WEBHOOK_SECRET=whsec_...

# Signing secret of the payment source endpoint (Studio → Payment sources →
# your source → Endpoint). Required by POST /voidhash/provider.
VOIDHASH_PROVIDER_SECRET=vhps_...

# Optional overrides.
# VOIDHASH_PAYMENT_SOURCE=nimbus-pay
# PUBLIC_URL=http://localhost:8080
# VOIDHASH_BASE_URL=https://api.voidhash.com
# VOIDHASH_INGEST_URL=https://ingest.voidhash.com
# PORT=8080
