# Publishable key from Studio → Project settings → API keys (starts with vh_pk_).
# Safe to ship in a client app; the secret key (vh_sk_) never belongs here.
EXPO_PUBLIC_VOIDHASH_PUBLISHABLE_KEY=vh_pk_your_publishable_key

# Optional. Point the SDK at a different API origin (a local stack, a staging
# environment). Defaults to https://api.voidhash.com.
# EXPO_PUBLIC_VOIDHASH_BASE_URL=http://localhost:1337

# Optional. Set to "true" to log every SDK HTTP request and response.
# EXPO_PUBLIC_VOIDHASH_DEBUG=false
