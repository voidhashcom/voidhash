NODE_ENV=production
APP_ENV=production
EXPO_PUBLIC_VOIDHASH_PUBLISHABLE_KEY=vh_pk_your_publishable_key
# Optional explicit API URL override (e.g. http://192.168.1.100:5001)
EXPO_PUBLIC_VOIDHASH_API_URL=
# Optional local API switch: 1/true to infer local host on port 5001.
# In development, local API is used by default when EXPO_PUBLIC_VOIDHASH_API_URL is unset.
EXPO_PUBLIC_VOIDHASH_USE_LOCAL_API=
