# Publishable key from Settings → API keys in Voidhash. Required.
# Publishable keys are safe to ship in a browser bundle. Use the test key
# (vh_pk_test_) on a staging site and the production key (vh_pk_) in production.
VITE_VOIDHASH_PUBLISHABLE_KEY=vh_pk_...

# Where the dev server's first-party proxy at /vh forwards to. Defaults to the
# hosted API; point it at a local Voidhash API when you run one.
# VOIDHASH_API_URL=http://localhost:4000

# Where the dev server's /backend proxy forwards to: the Node backend example,
# which creates the Buy with Nimbus Pay checkout. Defaults to localhost:8080.
# NIMBUS_BACKEND_URL=http://localhost:8080

# Optional: send to another origin instead of this site's /vh proxy.
# VITE_VOIDHASH_BASE_URL=https://api.voidhash.com
