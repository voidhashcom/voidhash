# Secret key for your project (Studio -> Project settings -> API keys).
# Grants full project access — keep it on the server, never in an app bundle.
VOIDHASH_SECRET_KEY=vh_sk_...

# Signing secret of the webhook endpoint that points at /webhooks/voidhash.
# Without it that route rejects every delivery.
VOIDHASH_WEBHOOK_SECRET=whsec_...

# Management API root. Defaults to https://api.voidhash.com.
# VOIDHASH_BASE_URL=https://api.voidhash.com

# Analytics ingestion origin. Defaults to https://ingest.voidhash.com.
# VOIDHASH_INGEST_URL=https://ingest.voidhash.com

# Defaults to 8080.
# PORT=8080
