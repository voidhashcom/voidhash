# Required. Secret key from Studio → Project settings → API keys. It grants
# full project access — keep it on the server and out of your repository.
# A staging server uses a test secret key (vh_sk_test_...) instead.
VOIDHASH_SECRET_KEY=vh_sk_...

# Required to accept POST /webhooks/voidhash. The signing secret of the
# endpoint you registered in Studio → Project settings → Webhooks.
VOIDHASH_WEBHOOK_SECRET=whsec_...

# Optional. Management API base URL. Defaults to https://api.voidhash.com
# VOIDHASH_BASE_URL=https://api.voidhash.com

# Optional. Event ingestion base URL. Defaults to https://ingest.voidhash.com
# VOIDHASH_INGEST_URL=https://ingest.voidhash.com

# Optional. Slug of the payment source Nimbus's own billing reports to; its
# provider endpoint answers for it. Defaults to nimbus-billing
# VOIDHASH_PAYMENT_SOURCE=nimbus-billing

# Required to accept POST /webhooks/billing. The same payment source's id
# (pp_conf_...), the last part of the address of its page in Studio. Payments
# are reported to it.
VOIDHASH_PAYMENT_SOURCE_ID=pp_conf_...

# Required to serve POST /voidhash/provider. The payment source's signing
# secret from Studio.
VOIDHASH_PROVIDER_SECRET=vhps_...

# Required to accept POST /webhooks/billing. Shared with the billing provider.
BILLING_WEBHOOK_SECRET=...

# Optional. Defaults to 8080
# PORT=8080
