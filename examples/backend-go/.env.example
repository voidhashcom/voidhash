# Required. Secret key from Studio → Project settings → API keys. It grants
# full project access — keep it on the server and out of your repository.
VOIDHASH_SECRET_KEY=vh_sk_...

# Required to accept POST /webhooks/voidhash. The signing secret of the
# endpoint you registered in Studio → Project settings → Webhooks.
VOIDHASH_WEBHOOK_SECRET=whsec_...

# Optional. Publishable key, sent as the `token` of every captured event.
# Without it the analytics calls are skipped and POST /v1/events answers 503.
VOIDHASH_PUBLISHABLE_KEY=vh_pk_...

# Optional. Management API base URL. Defaults to https://api.voidhash.com
# VOIDHASH_BASE_URL=https://api.voidhash.com

# Optional. Event ingestion base URL. Defaults to https://ingest.voidhash.com
# VOIDHASH_INGEST_URL=https://ingest.voidhash.com

# Optional. Defaults to 8080
# PORT=8080
