# Secret key for your project: Studio → Project settings → API keys.
# It grants full project access — keep it on the server, never in a client.
VOIDHASH_SECRET_KEY=vh_sk_...

# Signing secret of the webhook endpoint you created in Studio.
# Required by POST /webhooks/voidhash; the rest of the service runs without it.
VOIDHASH_WEBHOOK_SECRET=whsec_...

# Override these only if you are pointed at a non-production Voidhash.
# VOIDHASH_BASE_URL=https://api.voidhash.com
# VOIDHASH_INGEST_URL=https://ingest.voidhash.com

# Port for `php -S`. Behind php-fpm your web server decides this instead.
# PORT=8080

# Where the demo keeps its notes, entitlement cache and webhook dedupe set.
# Defaults to a directory under the system temp dir. See src/Nimbus/StateFile.php.
# NIMBUS_STATE_DIR=/tmp/nimbus-backend-php
