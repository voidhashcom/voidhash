{
  "$schema": "https://turborepo.org/schema.json",
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "dev:server": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/*", "!.next/cache/**"],
      "env": [
        "VITE_APP_API_URL",
        "VITE_APP_ENV",
        "VITE_EXAMPLE_SERVER_URL",
        "VOIDHASH_NODE_BUNDLE"
      ]
    },
    "clean": {},
    "format": {},
    "lint": {},
    "start": {
      "cache": false
    },
    "test": {
      "dependsOn": ["build"],
      "outputs": []
    },
    "test:platform": {
      "cache": false,
      "dependsOn": [],
      "outputs": []
    },
    "typecheck": {
      "outputs": []
    },
    "deploy": {
      "cache": false
    },
    "migrate": {
      "cache": false
    },
    "generate": {
      "cache": false
    }
  }
}
